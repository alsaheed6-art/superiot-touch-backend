NODE_ENV=development
PORT=3001

# Comma-separated exact browser origins. Add the deployed Amplify origin when known.
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Set all DB_* values together to enable MySQL-backed catalog reads.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Reserved for the future authentication module; not currently consumed.
JWT_SECRET=